#!/usr/bin/env bash
# macOS GUI launches skip /etc/profile, so /etc/paths.d entries (TeX, ...) are missing from PATH.
if [ -x /usr/libexec/path_helper ]; then
    eval "$(/usr/libexec/path_helper -s)"
fi
# MacPorts is not in /etc/paths.d
[ -d /opt/local/bin ] && export PATH="/opt/local/bin:$PATH"
exec nvim "$@"
