-- Hardware-dependent parts (network interface, temperature sensors) are
-- detected at startup by sysinfo.lua, shared with the rings script.
local dir = os.getenv('HOME') .. '/dotfiles/conky/manjaro/'
local sysinfo = dofile(dir .. 'sysinfo.lua')
local label_font = 'SFMono Nerd Font Mono:size=10:style=bold'

conky.config = {
--========================  Aqua-rings-110.conkyrc  ========================================
--
-- Heavily modified version of SunForMiles.conkyrc;
-- Ported to Conky v1.10;
-- Removed unecessary ${font} calls, tweaked positions, colours etc;
-- Added BL forum atomfeed;
-- Designed to complement BunsenLabs Beam desktop themeing
--
-- by damo, July2017  <damo.linux@gmail.com>
--
--=======================  Modification of  ================================================
-- SunForMiles.conkyrc
-- Date    : 05 July 2017
-- Author  : Sun For Miles
-- Version : v0.41
-- License : Distributed under the terms of GNU GPL version 2 or later
--
-- This version is a modification of conkyrc_seamod, which is modification of conkyrc_lunatico,
-- which is modification of conkyrc_orange
--
-- conkyrc_orange:    http://gnome-look.org/content/show.php?content=137503&forumpage=0
-- conkyrc_lunatico:  http://gnome-look.org/content/show.php?content=142884
-- conkyrc_seamod:    http://custom-linux.deviantart.com/art/Conky-Seamod-v0-1-283461046
--=============================================================================================

    background = true,
    update_interval = 1,

    cpu_avg_samples = 1,
    net_avg_samples = 2,
    temperature_unit = 'celsius',

    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 2048,

    -- minimum_width = 150, minimum_height = 600,
    -- maximum_width = 300,
    own_window = true,
    own_window_colour = '#00000000',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager,below',
    border_inner_margin = 30,
    border_outer_margin = 0,

    -- Single Monitor
    alignment = 'top_right',
    gap_x = 20,
    gap_y = 20,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    override_utf8_locale = true,
    use_xft = true,
    --font = 'caviar dreams:size=10',
    font = 'SFMono Nerd Font Mono:size=10',
    xftalpha = 0.5,
    uppercase = false,

    -- Defining colors
    default_color = '#FFFFFF',
    -- Shades of Gray
    color1 = 'DDDDDD',
    color2 = 'AAAAAA',
    color3 = '888888',
    color4 = '678b8b',
    color5 = '284f63',
    color6 = '617b78',
    color7 = '668989',
    color8 = 'dae1e3',
    color9 = '6B9083',

    -- Loading lua script for drawing rings
    lua_load = dir .. 'Aqua-rings-110.lua',
    lua_draw_hook_post = 'main',
};

local text = [[
    ${voffset 40}${alignr}${color4} ${kernel}

    # CPU
    ${voffset -30}
    ${font SFMono Nerd Font Mono:size=14:style=bold}${color4}${alignr} CPU
    ${alignr}${cpugraph cpu0 40,170 -t}
    # Showing TOP 5 CPU-consumers
    ${voffset -10}
    ${goto 115}${font}${color1}${top name 1}${alignr}${top cpu 1}%
    ${goto 115}${top name 2}${alignr}${top cpu 2}%
    ${goto 115}${color2}${top name 3}${alignr}${top cpu 3}%
    ${goto 115}${color3}${top name 4}${alignr}${top cpu 4}%
    ${goto 115}${top name 5}${alignr}${top cpu 5}%

    # Memory
    ${voffset 18}
    ${font SFMono Nerd Font Mono:size=14:style=bold}${color4}${alignr} MEM
    ${voffset 10}
    ${goto 115}${font}${color1}${top_mem name 1}${alignr}${top_mem mem_res 1}
    ${goto 115}${top_mem name 2}${alignr}${top_mem mem_res 2}
    ${goto 115}${color2}${top_mem name 3}${alignr}${top_mem mem_res 3}
    ${goto 115}${color3}${top_mem name 4}${alignr}${top_mem mem_res 4}
    ${goto 115}${top_mem name 5}${alignr}${top_mem mem_res 5}

    # Disks
    ${voffset 18}
    ${font SFMono Nerd Font Mono:size=14:style=bold}${color4}${alignr}󰋊 DISKS
    ${voffset -5}
    ${alignr}${diskiograph 20,180 666666 68364B -t -l}
    ${font}${color1}${lua_parse disk_rows}

    # Network
    ${voffset 18}
    ${font SFMono Nerd Font Mono:size=14:style=bold}${color4}${alignr}󰈀 NETWORK
    ${voffset -5}
    ${offset 71}${font}${color1}Down: ${downspeed @IFACE@} ${alignr}Up: ${upspeed @IFACE@}
    ${voffset -20}
    ${offset 80}${color4}${downspeedgraph @IFACE@ 50,100} ${alignr}${upspeedgraph @IFACE@ 50,100}

    # Temp
    ${voffset 18}
    ${font SFMono Nerd Font Mono:size=14:style=bold}${color4}${alignr}󰔏 TEMP
    ${voffset -15}
@TEMPS@
    ${execpi 30 ~/dotfiles/conky/manjaro/disktemp.sh '@LABEL_FONT@'}
]]

local temps = {}
local gpu = sysinfo.gpu_temp()
if gpu then table.insert(temps, { label = 'GPU', expr = gpu }) end
for _, t in ipairs(sysinfo.cpu_temps()) do table.insert(temps, t) end
local temp_rows = {}
for _, t in ipairs(temps) do
    table.insert(temp_rows, '    ${color1}${alignr}${font ' .. label_font .. '}' .. t.label .. ':  ${font}' .. t.expr .. '°C')
end

local values = {
    IFACE = sysinfo.net_iface(),
    TEMPS = table.concat(temp_rows, '\n'),
    LABEL_FONT = label_font,
}
conky.text = text:gsub('@(%u[%u_]*)@', values)
