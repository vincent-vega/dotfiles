#!/usr/bin/env bash

open() {
    # shellcheck disable=SC2154
    if [ "$__os_family" = "Linux" ]; then
        if command -v rifle &>/dev/null; then
            local text_files=()
            for x in "$@"; do
                [ -e "$x" ] || continue
                if [[ $(rifle -l "$x" | head -1) =~ ^0:editor:: ]]; then
                    text_files+=("$x")
                else
                    rifle -- "$x" &>/dev/null &
                fi
            done
            if (( ${#text_files[@]} > 0 )); then
                rifle "${text_files[@]}"
            fi
        else
            for x in "$@"; do
                xdg-open "$x"
            done
        fi
    else
        command open "$@"
    fi
} 2>/dev/null

echoline() {
    if [ "$#" -ne 2 ]; then
        echo 1>&2 "Echo specific file line"
        echo 1>&2 "Usage: ${FUNCNAME[0]} FILE LINE_NUM"
        return 1
    fi
    if [ ! -f "$1" ]; then
        echo 1>&2 "File not found: $1"
        echo 1>&2 "Usage: ${FUNCNAME[0]} FILE LINE_NUM"
        return 1
    fi
    if [[ ! "$2" =~ ^[0-9]+$ ]]; then
        echo 1>&2 "Invalid line number: $2"
        echo 1>&2 "Usage: ${FUNCNAME[0]} FILE LINE_NUM"
        return 1
    fi
    sed "${2}q;d" "$1"
}

mkcd() {
    if [ "$#" -ne 1 ]; then
        echo 1>&2 "Make dir and move into it"
        echo 1>&2 "Usage: ${FUNCNAME[0]} DIR_NAME"
        return 1
    fi
    mkdir "$1" || return
    cd "$1" || return
}

# {{{ Subversion

sup() { svn up "$@"; }

sst() { svn st "$@"; }

sdiff() {
    svn diff -x -w -x --ignore-eol-style "$@" | vim -R -n - +"file svn-diff" -c "set nowrap"
}

ssync() {
    svn diff -r BASE:HEAD "$@" | vim -R -n - +"file svn-sync" -c "set nowrap"
}

svnstash() {
    if [ "$#" -lt 1 ]; then
        echo 1>&2 "Print current developments patch"
        echo 1>&2 "Usage: ${FUNCNAME[0]} PATH..."
        return 1
    fi
    local unversioned
    unversioned=$(svn status "$@" | grep "^?" | sed -r 's/^\? +//')

    if [ -n "$unversioned" ]; then
        local tmp_file
        tmp_file=$(mktemp "${TMPDIR:-/tmp}/svnstash.XXXXXX")
        echo 1>&2 "Created temp file $tmp_file"
        # logging unversioned files to tmp_file
        echo 1>&2 "$unversioned" > "$tmp_file"
        # adding unversioned files
        xargs -r -d '\n' svn add < "$tmp_file" 1>&2
    fi

    svn diff "$@"

    if [ -s "$tmp_file" ]; then
        # removing unversioned files
        xargs -r -d '\n' svn delete --keep-local < "$tmp_file" 1>&2
        # clean
        rm -f "$tmp_file"
        echo 1>&2 "Temp file removed"
    fi
}

svnhistory() {
    if [ "$#" -ne 1 ]; then
        echo 1>&2 "Usage: ${FUNCNAME[0]} PATH"
        return 1
    fi
    local url
    url="$1"
    svn log -q "$url" | "grep" -E -e "^r[[:digit:]]+" -o | cut -c2- | sort -n | {
        # first revision as full text
        read -r r
        svn log -r"$r" "$url"@HEAD
        svn cat -r"$r" "$url"@HEAD
        while read -r r; do
            echo
            svn log --diff -r"$r" "$url"@HEAD
        done
    }
}

ssvnhistory() { svnhistory "$@" | colordiff; }

svnhistoryr() {
    if [ "$#" -ne 1 ]; then
        echo 1>&2 "Usage: ${FUNCNAME[0]} PATH"
        return 1
    fi
    local url first
    url="$1"
    first=$(svn log -r 1:HEAD --limit 1 -q "$url" | "grep" -E -e "^r[[:digit:]]+" -o | cut -c2-)
    if [ ! "$first" ]; then
        return 1
    fi
    svn log -q "$url" | "grep" -E -e "^r[[:digit:]]+" -o | cut -c2- | sort -rn | {
        while read -r r; do
            echo
            if [ "$r" == "$first" ]; then
                # first revision as full text
                svn log -r"$r" "$url"@HEAD
                svn cat -r"$r" "$url"@HEAD
            else
                svn log --diff -r"$r" "$url"@HEAD
            fi
        done
    }
}

ssvnhistoryr() { svnhistoryr "$@" | colordiff; }

svnactivity() {
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
        echo 1>&2 "Print the last NUM commits"
        echo 1>&2 "Usage: ${FUNCNAME[0]} USERNAME NUM [PATH]"
        return 1
    fi
    local svnpath="${3:-.}" c
    local -a commits
    # newest first; head stops svn log as soon as NUM commits are found
    mapfile -t commits < <(svn log -q "$svnpath" \
        | awk -F' [|] ' -v user="$1" '$2 == user { print $1 }' | head -n "$2")
    echo 1>&2 "Found commits: ${commits[*]}"
    (( ${#commits[@]} )) || return 1
    for c in "${commits[@]}"; do
        svn log -"$c" --diff "$svnpath"
    done
}

ssvnactivity() { svnactivity "$@" | colordiff; }

# }}}

# {{{ Git

gst() { git status "$@"; }

gunstage() { git restore --staged "$@"; }

gmc() {
    local green yellow red reset
    if [[ -t 1 ]]; then
        green=$'\e[1;32m'; yellow=$'\e[1;33m'
        red=$'\e[1;31m';   reset=$'\e[0m'
    fi
    local base="${1:-main}"
    if git merge-tree --write-tree "$base" HEAD >/dev/null; then
        printf '%sClean%s\n' "$green" "$reset"
    else
        local rc=$?
        if [ "$rc" -eq 1 ]; then
            printf '%sConflicts%s\n' "$yellow" "$reset"
            git merge-tree --write-tree --name-only "$base" HEAD | tail -n +2
        else
            printf '%sError%s\n' "$red" "$reset" >&2
        fi
        return "$rc"
    fi
}

# }}}

ff() {
    local grep_pattern
    if [ "$#" -eq 0 ]; then
        # current directory
        find . -type f -exec sh -c 'ls -lh "$@"' -- "{}" \+ | grep -v ".DS_Store" | cat -n
    elif [ "$#" -eq 1 ]; then
        if [ -d "$1" ]; then
            # directory
            echo 1>&2 "Listing files in dir $1"
            find "$1" -type f -exec sh -c 'ls -lh "$@"' -- "{}" \+ | grep -v ".DS_Store" | cat -n
        elif [ "$1" == "-t" ]; then
            find . -type f -exec sh -c 'ls -lrht "$@"' -- "{}" \+
        else
            grep_pattern=$(sed -r 's/\*+/.*/g' <<< "$1")
            find . -type f -iname '*'"$1"'*' -exec sh -c 'ls -lh "$@"' -- "{}" \+ | grep -v ".DS_Store" | cat -n | grep -E -i "$grep_pattern"
        fi
    elif [ "$#" -eq 2 ]; then
        if [ "$1" == "-t" ]; then
            if [ ! -d "$2" ]; then
                echo 1>&2 "Target path is not a directory: $2"
                return 1
            fi
            find "$2" -type f -exec sh -c 'ls -lrht "$@"' -- "{}" \+
        elif [ ! -d "$1" ]; then
            echo 1>&2 "Target path is not a directory: $1"
            return 1
        else
            grep_pattern=$(sed -r 's/\*+/.*/g' <<< "$2")
            find "$1" -type f -iname '*'"$2"'*' -exec sh -c 'ls -lh "$@"' -- "{}" \+ | grep -v ".DS_Store" | cat -n | grep -E -i "$grep_pattern"
        fi
    else
        echo 1>&2 "Too many arguments"
        return 1
    fi
}

fd() {
    if [ "$#" -eq 0 ]; then
        find . -type d | cat -n
    elif [ "$#" -eq 1 ]; then
        find . -type d -iname '*'"$1"'*' | cat -n | grep -i "$1"
    elif [ "$#" -eq 2 ]; then
        if [ ! -d "$1" ]; then
            echo 1>&2 "Target path is not a directory: $1"
            return 1
        fi
        find "$1" -type d -iname '*'"$2"'*' | cat -n | grep -i "$2"
    elif [ "$#" -gt 2 ]; then
        echo 1>&2 "Too many arguments"
        return 1
    fi
}

rmalljarsign() {
    local file
    for file in *jar; do
        echo 1>&2 "$file"
        zip -d "$file" 'META-INF/*.SF' 'META-INF/*.RSA' 'META-INF/*.DSA'
    done
}

rmjarsign() {
    if [ "$#" -eq 0 ]; then
        echo 1>&2 "Usage: ${FUNCNAME[0]} JAR_FILE..."
        return 1
    fi
    local jarfile
    for jarfile in "$@"; do
        if [ ! -f "$jarfile" ]; then
            echo 1>&2 "File $jarfile does not exist"
            continue
        fi
        zip -d "$jarfile" 'META-INF/*.SF' 'META-INF/*.RSA' 'META-INF/*.DSA'
    done
}

xml() {
    xmllint --format "$1" | pygmentize -l xml | less
}

colordiff() {
    local e=$'\e'
    sed -E -e "s/^(\+\+\+ .+|--- .+|-{4,}|=+)$/${e}[1;38;5;74m&${e}[0m/" -e t \
           -e "s/^\+.*/${e}[0;38;5;36m&${e}[0m/" -e t \
           -e "s/^-.*/${e}[0;38;5;167m&${e}[0m/" -e t \
           -e "s/^(@@ .+ @@)(.*)$/${e}[1;38;5;244m\1${e}[0m\2/"
}

gradle_dependencies() {
    if [ "$1" == "-h" ]; then
        echo 1>&2 "List runtime dependencies"
        echo 1>&2 "Usage: ${FUNCNAME[0]} [SUBPROJECT]"
        return 1
    fi
    if [ "$#" -gt 1 ]; then
        echo 1>&2 "List runtime dependencies"
        echo 1>&2 "Usage: ${FUNCNAME[0]} [SUBPROJECT]"
        return 1
    fi
    if [ ! -x gradlew ]; then
        echo 1>&2 "Error: gradlew not found"
        return 1
    fi
    local subproject
    if [[ -n "$1" ]]; then
        subproject=$(sed -r -e "s@/@:@g" <<< "$1")
        [[ "${subproject}" != *: ]] && subproject="${subproject}:"
    fi
    if command -v pygmentize &>/dev/null; then
        pygmentize <<< "$(./gradlew "$subproject"dependencies)" 2> /dev/null | less
    else
        ./gradlew "$subproject"dependencies 2>/dev/null | less
    fi
}

urlencode() {
    if [ "$#" -ne 1 ]; then
        echo 1>&2 "Usage: ${FUNCNAME[0]} STRING"
        return 1
    fi
    python3 -c "import urllib.parse;print(urllib.parse.quote_plus('${1//\'/\\\'}'))"
}

urldecode() {
    if [ "$#" -ne 1 ]; then
        echo 1>&2 "Usage: ${FUNCNAME[0]} STRING"
        return 1
    fi
    python3 -c "import urllib.parse;print(urllib.parse.unquote('${1//\'/\\\'}'))"
}

# Section header: ━━ TITLE ╶╶╶╶╶╶╶╶  [COUNTER]
_section() {
    local blue b_white dim reset
    [[ -t 1 ]] && { blue=$'\e[34m'; b_white=$'\e[1;97m'; dim=$'\e[2m'; reset=$'\e[0m'; }
    printf '%s━━ %s%s%s %s╶╶╶╶╶╶╶╶%s\n' "$blue" "$b_white" "$1" "$reset" "$dim" "${2:+  $2}$reset"
}

if [ "$__os_family" = "Mac" ]; then
    instupdate() {
        local green yellow red reset
        if [[ -t 1 ]]; then
            green=$'\e[32m'; yellow=$'\e[33m'; red=$'\e[31m'; reset=$'\e[0m'
        fi
        # label|required command|command line
        local steps=(
            'MacPorts|port|sudo port selfupdate && port outdated'
            'npm (global)|npm|npm outdated -g'
            'sdk|sdk|sdk update'
            'macOS|softwareupdate|softwareupdate --list'
            'uv tools|uv|uv tool list --outdated'
            'claude|claude|claude update'
        )
        local step label bin cmd row icon note el rc us t0 i=0
        local start=${EPOCHREALTIME/[.,]/} summary=()

        # ask for the password now rather than in the middle of the run
        command -v port &>/dev/null && { sudo -v || return; }

        for step in "${steps[@]}"; do
            IFS='|' read -r label bin cmd <<< "$step"
            _section "$label" "$(( ++i ))/${#steps[@]}"
            if ! command -v "$bin" &>/dev/null; then
                icon="${yellow}⊘${reset}" el='' note='not found'
            else
                t0=${EPOCHREALTIME/[.,]/}
                eval "$cmd"
                rc=$?
                us=$(( ${EPOCHREALTIME/[.,]/} - t0 ))
                if (( rc == 0 )); then
                    icon="${green}✔${reset}" note=''
                elif [[ $bin == npm ]] && (( rc == 1 )); then
                    # npm outdated exits 1 when it finds something
                    icon="${yellow}●${reset}" note='outdated packages'
                else
                    icon="${red}✖${reset}" note="exit $rc"
                fi
                printf -v el '%d.%ds' "$(( us / 1000000 ))" "$(( us / 100000 % 10 ))"
            fi
            # footer only: the command's own output is never piped, so it keeps its tty
            printf '└ %s %s%s\n\n' "$icon" "${el:+$el  }" "$note"
            printf -v row '  %s  %-14s %7s  %s' "$icon" "$label" "${el:--}" "$note"
            summary+=("$row")
        done

        _section "summary"
        printf '%s\n' "${summary[@]}"
        us=$(( ${EPOCHREALTIME/[.,]/} - start ))
        printf '     %-14s %4d.%ds\n' total "$(( us / 1000000 ))" "$(( us / 100000 % 10 ))"
    }
fi

mdfind() { command mdfind -0 "$@" 2>/dev/null | xargs -0 ls -dG; }
