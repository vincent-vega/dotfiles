# shellcheck shell=bash
[ -z "$PS1" ] && return

case $(uname -s) in
    Darwin*) __os_family=Mac;;
    Linux*)  __os_family=Linux;;
    CYGWIN*) __os_family=Cygwin;;
    *)       __os_family=Linux;;
esac

shopt -s autocd cdspell checkwinsize histappend

# shellcheck source=/dev/null
[[ -s "$HOME/dotfiles/bash/ps1_colors" ]] && source "$HOME/dotfiles/bash/ps1_colors"

if ! command -v __git_ps1 &>/dev/null; then
    if [ -s /opt/local/share/git/git-prompt.sh ]; then
        # MacPorts
        # shellcheck disable=SC1091
        source /opt/local/share/git/git-prompt.sh
    elif [ -s "/usr/share/git/completion/git-prompt.sh" ]; then
        # shellcheck disable=SC1091
        source "/usr/share/git/completion/git-prompt.sh"
    fi
fi
if command -v __git_ps1 &>/dev/null; then
    # shellcheck disable=SC2034
    GIT_PS1_SHOWCOLORHINTS=1 GIT_PS1_SHOWCONFLICTSTATE=1 GIT_PS1_SHOWDIRTYSTATE=1 GIT_PS1_SHOWSTASHSTATE=1 GIT_PS1_SHOWUNTRACKEDFILES=1
else
    __git_ps1() { true; }
fi
# shellcheck disable=SC2154
PS1="${BGrey27}"'['"${DodgerBlue1}"'\u'"${BGrey27}"']'"${White}"'@\
'"${BGrey27}"'['"${Red}"'\h'"${BGrey27}"']'"${White}"' \A '"${PaleGreen3}"'\
\w\r\n'"${ResetColor}"'#$(__git_ps1) '

# shellcheck source=/dev/null
[[ -s "$HOME/dotfiles/bash/env" ]] && source "$HOME/dotfiles/bash/env"

# bash-completion must load after env: its _comp_expand_glob derives a local LC_CTYPE from LANG,
# and an unset LANG makes bash 5.3 warn "setlocale: LC_COLLATE: cannot change locale ()" three times
# enable bash completion in interactive shells
if ! shopt -oq posix; then
    if [ -s /usr/share/bash-completion/bash_completion ]; then
        # shellcheck source=/dev/null
        source /usr/share/bash-completion/bash_completion
    elif [ -s /etc/bash_completion ]; then
        # shellcheck source=/dev/null
        source /etc/bash_completion
    elif [ -r /opt/local/etc/profile.d/bash_completion.sh ]; then
        # MacPorts. The azure-cli port ships a broken az completion (calls a non-existent argcomplete module,
        # prints an error at every shell start): skip that file and register az the way argcomplete intends.
        BASH_COMPLETION_COMPAT_IGNORE="az"
        # shellcheck source=/dev/null
        source /opt/local/etc/profile.d/bash_completion.sh
        for __rpa in /opt/local/bin/register-python-argcomplete-3.*; do
            [ -x "$__rpa" ] && eval "$("$__rpa" --shell bash az)" && break
        done
        unset __rpa
    fi
fi

# sudo: bash-completion delegates to the wrapped command's completion (`sudo port <TAB>` completes port
# subcommands); registering `complete -cf sudo` ourselves would override that, so only do it without it
[ -n "${BASH_COMPLETION_VERSINFO+x}" ] || complete -cf sudo

# shellcheck source=/dev/null
[[ -s "$HOME/dotfiles/bash/bash_aliases" ]] && source "$HOME/dotfiles/bash/bash_aliases"

if command -v fzf &>/dev/null; then
    if __fzf_bash=$(fzf --bash 2>/dev/null); then
        eval "$__fzf_bash"
    else # fzf < 0.48 (e.g. debian/ubuntu packages)
        # shellcheck source=/dev/null
        [ -s /usr/share/doc/fzf/examples/key-bindings.bash ] && source /usr/share/doc/fzf/examples/key-bindings.bash
        # shellcheck source=/dev/null
        [ -s /usr/share/doc/fzf/examples/completion.bash ] && source /usr/share/doc/fzf/examples/completion.bash
    fi
    unset __fzf_bash
    if declare -F _fzf_setup_completion >/dev/null; then
        _fzf_setup_completion 'dir'  fd ff
        _fzf_setup_completion 'path' cmp cp jq la ll ln lt mv vimdiff
        if command -v pbcopy &>/dev/null; then
            _fzf_setup_completion 'path' pbcopy
        fi
    fi
fi

if [ "$__os_family" = "Cygwin" ]; then
    __ssh_host_completion() {
        local cur opts
        cur="${COMP_WORDS[COMP_CWORD]}"
        opts=$(grep '^Host' "$HOME/.ssh/config" "$HOME/.ssh/config.d"/* 2>/dev/null | grep -v '[?*]' | cut -d ' ' -f 2-)
        #COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        mapfile -t COMPREPLY < <( compgen -W "$opts" -- "$cur" )
        return 0
    }
    complete -F __ssh_host_completion ssh
fi

# shellcheck source=/dev/null
[[ -s "$HOME/dotfiles/bash/functions" ]] && source "$HOME/dotfiles/bash/functions"
# shellcheck source=/dev/null
[[ -s "$HOME/dotfiles/bash/obsopen" ]] && source "$HOME/dotfiles/bash/obsopen"

# SDKMAN defines `sdk` as a shell function, so it has to be sourced by every interactive shell, including the
# non-login ones tmux opens (bash_profile would only cover login shells). Keep it last: it prepends to PATH.
if [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
    export SDKMAN_DIR="$HOME/.sdkman"
    # shellcheck source=/dev/null
    source "$HOME/.sdkman/bin/sdkman-init.sh"
fi
